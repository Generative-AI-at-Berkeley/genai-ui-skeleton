# Copy to .env.local and fill in. Never commit .env.local.

# Your backend. Only the server-side proxy route calls it, so the browser never
# learns the address or the key. Leave blank to run the UI with no backend.
API_BASE_URL=http://localhost:8000

# Sent as a bearer token by the proxy. Blank when the backend runs locally with no key.
SERVICE_API_KEY=
