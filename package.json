{
  "name": "genai-ui-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "panda codegen && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "panda codegen && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "panda codegen",
    "lint:content": "python3 scripts/lint_content.py",
    "check": "pnpm lint && pnpm lint:content && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.1",
    "@pandacss/preset-panda": "^1.12.1",
    "@park-ui/cli": "^1.0.1",
    "@park-ui/panda-preset": "^0.43.1",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.12.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
